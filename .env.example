# ─── LLM Provider Configuration (required) ───
# POWER_LOOP_* is the primary configuration prefix
# Legacy OPENAI_COMPAT_* variables are still supported as fallback but deprecated

# The real-provider suite (tests/real) runs against DeepSeek v4.1 flash. Its API model name is
# `deepseek-flash` (the endpoint rejects "deepseek-v4.1-flash"). It can see images, but the
# tests do NOT assume that: capabilities are declared per test (tests/real/_llm.py), and the
# non-vision path is exercised against the same model.
POWER_LOOP_PROVIDER=openai
POWER_LOOP_BASE_URL=https://api.deepseek.com/v1
POWER_LOOP_API_KEY=
POWER_LOOP_MODEL=deepseek-flash

# Anthropic-compatible endpoint example:
# POWER_LOOP_PROVIDER=anthropic
# POWER_LOOP_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
# POWER_LOOP_API_KEY=sk-...
# POWER_LOOP_MODEL=deepseek-v4-flash

# ─── Model capabilities (NOT env-configurable) ───
# POWER_LOOP_SUPPORTS_* is retired. Capabilities are DECLARED on the config object:
#
#     LLMProviderConfig(..., capabilities={"supports_image_input": True})
#
# That scope is per-loop / per-agent-definition; a process-wide env var could not say
# "this definition's model sees images, that one's doesn't" when one process serves many
# models. Nothing is inferred from the model name either — sending an image to a model
# that has not declared support RAISES instead of being downgraded to a text placeholder.

# ─── Loop Runtime Configuration ───
CONTEXT_COMPACT_THRESHOLD=50000
